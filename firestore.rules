rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidUser(data) {
      return data.email is string &&
             (!('displayName' in data) || data.displayName is string) &&
             data.keys().hasAll(['email']) &&
             data.keys().size() >= 1;
    }

    function isValidAccount(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.balance is number &&
             data.initialBalance is number &&
             data.type in ['cash', 'bank', 'ewallet', 'other'] &&
             data.keys().hasAll(['userId', 'name', 'balance', 'initialBalance', 'type']) &&
             data.keys().size() == 5;
    }

    function isValidTransaction(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.accountId is string &&
             data.type in ['tarik_tunai', 'setor_tunai', 'topup', 'ppob', 'topup_game', 'transfer', 'transfer_bank', 'expense', 'adjustment'] &&
             data.amount is number &&
             data.fee is number &&
             (!('feeExternal' in data) || data.feeExternal is number) &&
             data.netAmount is number &&
             (!('toAccountId' in data) || data.toAccountId is string) &&
             (!('cashAccountId' in data) || data.cashAccountId is string) &&
             (!('bankType' in data) || data.bankType in ['same', 'other']) &&
             (!('note' in data) || data.note is string) &&
             (!('customerName' in data) || data.customerName is string) &&
             (!('referenceNumber' in data) || data.referenceNumber is string) &&
             (!('paymentStatus' in data) || data.paymentStatus in ['pending', 'success', 'failed']) &&
             data.timestamp is timestamp &&
             data.keys().hasAll(['userId', 'accountId', 'type', 'amount', 'fee', 'netAmount', 'timestamp']) &&
             data.keys().size() >= 7;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Accounts collection
    match /accounts/{accountId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow list, get: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId);
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
